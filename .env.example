# Required in production. Long random string. Sessions are forged if this leaks.
AUTH_SECRET=

# Absolute URL of this portal, used in confirmation emails and tracking links.
# Example: https://emit-portal-test.example.com
PORTAL_PUBLIC_URL=http://localhost:3000

# SQLite file. Use a persistent disk in deployment. Not used once orders come from SAM,
# but the review queue, users, and documents still need durable storage.
PORTAL_DB_PATH=./data/portal.db

# Seed demo users and fake shipments. Set to false before any real EMIT user can sign in.
# Defaults to true outside production and false in production.
DEMO_SEED=true
DEMO_USER_PASSWORD=Emit-Demo-2026

# The only portal admins. Select staff, Google sign-in. Do not add EMIT addresses.
SELECT_ADMIN_EMAILS=mgray@goselect.com,dmartin@goselect.com

# EMIT staff who may sign in with Microsoft. They see every EMIT load.
# Receivers are not listed here. Register them under Settings → Receivers
# (email or domain, matched to a destination company).
EMIT_EMAIL_DOMAINS=emit.example,emit.com,emittechnologies.com
EMIT_ALLOWED_EMAILS=

# Google Workspace for Select. Internal OAuth client in the goselect.com organization.
# Redirect URI: {PORTAL_PUBLIC_URL}/api/auth/google/callback
# JavaScript origin: the origin of PORTAL_PUBLIC_URL
# Scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=goselect.com

# Microsoft Entra ID for EMIT staff and receivers. Select does not use this.
# Redirect URI: {PORTAL_PUBLIC_URL}/api/auth/microsoft/callback
# Scopes: openid, profile, email
# Tenant: EMIT's tenant id if receivers are guests in that tenant.
# Use organizations if receivers sign in from their own Microsoft 365 tenants.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Demo password sign-in. On in non-production, and when DEMO_SEED=true.
# Production with DEMO_SEED unset or false rejects passwords.
# ALLOW_PASSWORD_LOGIN=true is an explicit break-glass override.
ALLOW_PASSWORD_LOGIN=

# Email. Confirmation is stored in the in-app outbox either way.
# When these are set, the same message is also sent over SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. When set, "Ask about an SO" uses an OpenAI-compatible chat API.
# The model only receives the customer-safe shipment view. Leave blank to use the built-in answers.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# SAM TMS. Leave blank to use the mock store. All three are required to switch.
# The HTTP paths are a placeholder contract — confirm them when credentials arrive.
# Customer responses are still passed through the carrier-pay filter.
SAM_API_BASE_URL=
SAM_API_TOKEN=
SAM_CUSTOMER_ID=

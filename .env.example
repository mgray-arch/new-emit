# Production environment for the EMIT portal on Vercel.
# Copy this list into the Vercel project (Production). Preview can use the same
# values except DEMO_SEED and NEXT_PUBLIC_DEMO_HINT, which stay on for a demo.
#
# Leave TURSO_* and BLOB_READ_WRITE_TOKEN blank for local SQLite and ./data/blobs.

# Required. Long random string, at least 16 characters. Sessions are forged if this leaks.
AUTH_SECRET=

# Public origin of this portal. Used in tracking links and receiver links.
# Example: https://emit.example.com
# On Vercel this can stay blank. Links then use https://$VERCEL_URL.
PORTAL_PUBLIC_URL=

# Hosted database. Required on Vercel. Leave both blank for local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Private file storage. Vercel fills this in when a Blob store is connected.
# Leave blank locally. Files then go in ./data/blobs.
BLOB_READ_WRITE_TOKEN=

# Local SQLite file. Used only when TURSO_DATABASE_URL is unset.
PORTAL_DB_PATH=./data/portal.db

# Demo data. Production must be false: empty database, no demo users, no demo password.
# Locally, omit this or set true to load the fake shipments on first start.
DEMO_SEED=false
# Ignored when DEMO_SEED is false. Local demo password when the seed runs.
# DEMO_USER_PASSWORD=Emit-Demo-2026

# Hide the on-screen demo accounts. Production must be false.
NEXT_PUBLIC_DEMO_HINT=false

# Select portal admins. Google sign-in only. Do not add EMIT addresses.
SELECT_ADMIN_EMAILS=mgray@goselect.com,dmartin@goselect.com

# Google Workspace for Select admins. Internal OAuth client in the goselect.com organization.
# Redirect URI: {PORTAL_PUBLIC_URL}/api/auth/google/callback
# JavaScript origin: the origin of PORTAL_PUBLIC_URL
# Scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=goselect.com

# Optional. Microsoft Entra ID for EMIT staff. Not required for go-live.
# EMIT staff sign in with the email and password a Select admin sets under Users.
# Redirect URI, if you turn this on later: {PORTAL_PUBLIC_URL}/api/auth/microsoft/callback
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# EMIT_EMAIL_DOMAINS=emit.example,emit.com,emittechnologies.com
# EMIT_ALLOWED_EMAILS=

# Optional. "Ask about an SO" uses this when set. Blank uses the built-in answers.
# The model only receives the customer-safe shipment view.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional. Bearer token for POST /api/ingest/carrier-photos. At least 16 characters.
# An admin session cookie can upload without this token. Leave blank to allow only admins.
CARRIER_PHOTO_INGEST_TOKEN=

# Not used at go-live. Leave blank until the SAM API is connected.
# A Select admin enters the SAM load number on each order until then.
# Customer responses still pass through the serializer, which drops carrier-pay fields.
SAM_API_BASE_URL=
SAM_API_TOKEN=
SAM_CUSTOMER_ID=

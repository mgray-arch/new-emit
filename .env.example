# Required in production. Long random string. Sessions are forged if this leaks.
AUTH_SECRET=

# Absolute URL of this portal, used in confirmation emails and tracking links.
# Example: https://emit-portal-test.example.com
# On Vercel this can stay blank. Links then use https://$VERCEL_URL.
PORTAL_PUBLIC_URL=http://localhost:3000

# Hosted database for Vercel. Leave both blank for local SQLite (no Turso account).
# TURSO_DATABASE_URL is the libsql:// URL from the Turso database page.
# TURSO_AUTH_TOKEN is a full-access token for that database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Private file storage for document and photo bytes.
# Vercel fills this in when a Blob store is connected to the project.
# Leave blank locally. Files then go in ./data/blobs.
BLOB_READ_WRITE_TOKEN=

# Local SQLite file, used only when TURSO_DATABASE_URL is unset.
PORTAL_DB_PATH=./data/portal.db

# Seed demo users and fake shipments. Set to false before any real EMIT user can sign in.
# Defaults to true outside production and false in production.
DEMO_SEED=true
DEMO_USER_PASSWORD=Emit-Demo-2026

# The only portal admins. Select staff, Google sign-in. Do not add EMIT addresses.
SELECT_ADMIN_EMAILS=mgray@goselect.com,dmartin@goselect.com

# EMIT staff who may sign in with Microsoft. They see every EMIT load, including customer cost.
# Receivers do not sign in. Add them under Settings → Receivers.
EMIT_EMAIL_DOMAINS=emit.example,emit.com,emittechnologies.com
EMIT_ALLOWED_EMAILS=

# Google Workspace for Select. Internal OAuth client in the goselect.com organization.
# Redirect URI: {PORTAL_PUBLIC_URL}/api/auth/google/callback
# JavaScript origin: the origin of PORTAL_PUBLIC_URL
# Scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=goselect.com

# Microsoft Entra ID for EMIT staff only. Select does not use this. Receivers do not sign in.
# Redirect URI: {PORTAL_PUBLIC_URL}/api/auth/microsoft/callback
# Scopes: openid, profile, email
# Tenant: EMIT's directory (single tenant).
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Demo password sign-in. On in non-production, and when DEMO_SEED=true.
# Production with DEMO_SEED unset or false rejects passwords.
# ALLOW_PASSWORD_LOGIN=true is an explicit break-glass override.
ALLOW_PASSWORD_LOGIN=

# Confirmation email. The message is always stored in the outbox.
# It is sent with the Gmail API when all four values below are set.
# EMAIL_FROM is the Select mailbox, or a send-as alias on that mailbox.
# Use a separate OAuth client from Google staff sign-in. Scope: https://www.googleapis.com/auth/gmail.send
EMAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional. When set, "Ask about an SO" uses an OpenAI-compatible chat API.
# The model only receives the customer-safe shipment view. Leave blank to use the built-in answers.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Bearer token for POST /api/ingest/carrier-photos. The assistant that reads carrier
# Gmail sends Authorization: Bearer <token>. At least 16 characters. An admin
# session cookie can upload without this token. Leave blank to allow only admins.
CARRIER_PHOTO_INGEST_TOKEN=

# SAM TMS. Leave blank to use the mock store. All three are required to switch.
# The HTTP paths are a placeholder contract — confirm them when credentials arrive.
# Customer responses are still passed through the serializer, which drops carrier-pay fields.
SAM_API_BASE_URL=
SAM_API_TOKEN=
SAM_CUSTOMER_ID=

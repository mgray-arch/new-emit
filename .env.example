# Required in production. Long random string, at least 16 characters.
# Sessions are forged if this leaks. Generate a new one; do not reuse a demo value.
AUTH_SECRET=

# Public site URL. No trailing slash. The app does not hardcode a hostname.
# Tracking links, receiver links, and the Google callback are built from this.
# Use the new domain, not an old site name. Example: https://portal.example.com
PORTAL_PUBLIC_URL=http://localhost:3000

# Hosted database on Vercel. Leave both blank for local SQLite.
# TURSO_DATABASE_URL is the libsql:// URL from the Turso database page.
# TURSO_AUTH_TOKEN is a full-access token for that database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Private file storage for document and photo bytes.
# Vercel fills this in when a Blob store is connected to the project.
# Leave blank locally. Files then go in ./data/blobs.
BLOB_READ_WRITE_TOKEN=

# Local SQLite file, used only when TURSO_DATABASE_URL is unset.
PORTAL_DB_PATH=./data/portal.db

# Demo users, demo password, and fake shipments.
# Production must be false. Unset in production also means false.
# true only on a private preview, and only before any real EMIT user exists.
DEMO_SEED=false

# Used only when DEMO_SEED=true. Ignored in production.
DEMO_USER_PASSWORD=Emit-Demo-2026

# Show the on-screen demo password. Leave unset or false in production.
# The password is not baked into the page. The server sends it only when the demo is on.
NEXT_PUBLIC_DEMO_HINT=false

# Select portal admins. Google sign-in only. Do not add EMIT addresses.
SELECT_ADMIN_EMAILS=mgray@goselect.com,dmartin@goselect.com

# EMIT staff who may be created on the Users page and, if Azure is ever turned on, who may use Microsoft.
# Production: set the real domains and drop emit.example.
# Receivers do not sign in. Add them under Settings → Receivers.
EMIT_EMAIL_DOMAINS=emit.com,emittechnologies.com
EMIT_ALLOWED_EMAILS=

# Google Workspace for Select admins. Internal OAuth client in the goselect.com organization.
# Redirect URI: {PORTAL_PUBLIC_URL}/api/auth/google/callback
# JavaScript origin: {PORTAL_PUBLIC_URL}
# Scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=goselect.com

# Optional. EMIT does not need Microsoft. Leave blank.
# If you turn it on later, redirect URI is {PORTAL_PUBLIC_URL}/api/auth/microsoft/callback
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Optional. "Ask about an SO" uses an OpenAI-compatible chat API when set.
# The model only receives the customer-safe shipment view. Leave blank for the built-in answers.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Bearer token for POST /api/ingest/carrier-photos. At least 16 characters.
# An admin session cookie can upload without this token. Leave blank to allow only admins.
CARRIER_PHOTO_INGEST_TOKEN=

# Bearer token for the email bot. At least 16 characters.
# Same key for POST /api/integrations/documents (BOL) and POST /api/integrations/tracking-link.
# Leave blank to reject every bot request. A session cookie is not accepted.
BOT_UPLOAD_KEY=

# SAM TMS. Leave all three blank. The portal does not call SAM yet.
# Customer responses still go through the serializer, which drops carrier-pay fields.
SAM_API_BASE_URL=
SAM_API_TOKEN=
SAM_CUSTOMER_ID=

# Load Builder bot. Leave blank until the bot exists. The Build load in SAM button
# returns an error and does not mark the load as building when the URL is unset.
# The secret is a bearer token, at least 16 characters, on the webhook and on the callback.
LOAD_BUILDER_WEBHOOK_URL=
LOAD_BUILDER_SECRET=

# Slack incoming webhook for a note when someone creates a load.
# Leave blank to send nothing. The note names the owner and who entered the load.
# It does not include carrier pay.
SLACK_NEW_LOADS_WEBHOOK_URL=

# Optional Slack member ids (like U012ABCDEF) so the owner line @mentions that person.
# Leave blank to use the plain names Drew and Ainsley.
SLACK_USER_ID_DREW=
SLACK_USER_ID_AINSLEY=

# Where a stored SAM load number should link. {loadNumber} is replaced.
# Example: https://sam.example.com/loads/{loadNumber}
# Leave blank to show the number without a link.
SAM_LOAD_URL_TEMPLATE=

# Slack incoming webhook for the shared EMIT/Select message thread.
# Leave blank to send nothing. A missing URL does not block the message.
# The note names the author, the load number when one is attached, a short preview,
# and a link to /messages. It does not include the full message or carrier pay.
# This is separate from SLACK_NEW_LOADS_WEBHOOK_URL.
SLACK_MESSAGES_WEBHOOK_URL=

# Optional comma-separated addresses to notify when an EMIT user posts.
# The app does not send email yet: there is no mail provider in this repo.
# Setting this does not send mail and does not break posting. A provider can be added later.
MESSAGE_NOTIFY_EMAILS=
